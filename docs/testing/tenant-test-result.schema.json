{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "variant": {
      "type": "string",
      "enum": [
        "baseline",
        "no-csp-meta"
      ]
    },
    "testDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "studio": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 40
        },
        "build": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "version",
        "build"
      ],
      "additionalProperties": false
    },
    "browser": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "version": {
          "type": "string",
          "maxLength": 40
        },
        "os": {
          "type": "string",
          "maxLength": 60
        }
      },
      "required": [
        "name",
        "version",
        "os"
      ],
      "additionalProperties": false
    },
    "tenant": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "releaseChannel": {
          "type": "string",
          "maxLength": 120
        },
        "htmlPagesEnabled": {
          "type": "boolean"
        },
        "copilotLicensed": {
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "releaseChannel",
        "htmlPagesEnabled",
        "copilotLicensed"
      ],
      "additionalProperties": false
    },
    "html": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "maxLength": 200
        },
        "utf8Bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10485760
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "uploadPath": {
          "type": "string",
          "maxLength": 300
        },
        "retrievedSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fileName",
        "utf8Bytes",
        "sha256",
        "uploadPath",
        "retrievedSha256"
      ],
      "additionalProperties": false
    },
    "sanitizationConfirmed": {
      "type": "boolean",
      "const": true
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-\\d{2}$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "expected": {
            "type": "string",
            "maxLength": 1000
          },
          "actual": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not-run"
            ]
          },
          "observations": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "evidence": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 200
                },
                "fileName": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^[\\w .()-]+$"
                }
              },
              "required": [
                "label",
                "fileName"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "expected",
          "actual",
          "status",
          "observations",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-\\d{2}$"
          },
          "area": {
            "type": "string",
            "enum": [
              "markup",
              "attributes",
              "css",
              "csp",
              "scripts",
              "encoding",
              "links",
              "layout",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "before": {
            "type": "string",
            "maxLength": 1000
          },
          "after": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "area",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 3000
    }
  },
  "required": [
    "schemaVersion",
    "variant",
    "testDate",
    "studio",
    "browser",
    "tenant",
    "html",
    "sanitizationConfirmed",
    "cases",
    "transformations",
    "summary"
  ],
  "additionalProperties": false
}
