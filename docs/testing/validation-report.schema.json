{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "studio-export-validation-report"
    },
    "generatedAt": {
      "type": "string"
    },
    "studio": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string"
        }
      },
      "required": [
        "build"
      ],
      "additionalProperties": false
    },
    "html": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string"
        },
        "utf8Bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limitBytes": {
          "type": "number",
          "const": 10485760
        },
        "percentOfLimit": {
          "type": "number",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "csp": {
          "type": "string"
        }
      },
      "required": [
        "fileName",
        "utf8Bytes",
        "limitBytes",
        "percentOfLimit",
        "sha256",
        "csp"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "properties": {
        "scriptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resourceReferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "linkTagCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inlineHandlerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sameSiteLinkCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "externalLinkCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "scriptCount",
        "resourceReferenceCount",
        "linkTagCount",
        "inlineHandlerCount",
        "sameSiteLinkCount",
        "externalLinkCount"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "errorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "errorCount",
        "warningCount",
        "issues"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "componentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "boundComponentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "componentCount",
        "boundComponentCount"
      ],
      "additionalProperties": false
    },
    "exportProfile": {
      "type": "string",
      "enum": [
        "static-safe",
        "interactive-safe"
      ]
    },
    "liveData": {
      "type": "object",
      "properties": {
        "experimentalFeatureUsed": {
          "type": "boolean"
        },
        "contractRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceLevel": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifestSourceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cspStatus": {
          "type": "string"
        },
        "refreshSupported": {
          "type": "boolean"
        },
        "permissionWarning": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifiersInExport": {
          "type": "boolean"
        },
        "cslViewLinkInExport": {
          "type": "boolean"
        },
        "explicitSharingDecisionRequired": {
          "type": "boolean"
        },
        "fallbackAvailable": {
          "type": "boolean"
        },
        "capability": {
          "anyOf": [
            {
              "type": "string",
              "const": "experimental"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissionTestOutstanding": {
          "type": "boolean"
        },
        "selectorEvidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "selectorType": {
                "type": "string"
              },
              "worksheet": {
                "type": "string"
              },
              "labelLength": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "matchColumn": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "valueOffset": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "caseSensitive": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "trim": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "snapshotFallbackPresent": {
                "type": "boolean"
              }
            },
            "required": [
              "selectorType",
              "worksheet",
              "labelLength",
              "matchColumn",
              "valueOffset",
              "caseSensitive",
              "trim",
              "snapshotFallbackPresent"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "experimentalFeatureUsed",
        "contractRevision",
        "evidenceLevel",
        "manifestSourceCount",
        "cspStatus",
        "refreshSupported",
        "permissionWarning",
        "identifiersInExport",
        "cslViewLinkInExport",
        "explicitSharingDecisionRequired",
        "fallbackAvailable",
        "capability",
        "permissionTestOutstanding",
        "selectorEvidence",
        "selectors"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "reportVersion",
    "kind",
    "generatedAt",
    "studio",
    "html",
    "checks",
    "validation",
    "project",
    "exportProfile",
    "liveData",
    "notes"
  ],
  "additionalProperties": false
}
